# GreenLedger — variables de ejemplo (SIN secretos).
# Copia este archivo a .env (ignorado por git) solo si lo necesitas.

# Este repositorio solo opera en testnet.
STELLAR_NETWORK=testnet

# Contract ID vigente (v2) en testnet. Debe coincidir con el alias
# "v2-vigente" de config/contracts.json (lo verifica scripts/check-contract-id.mjs).
CURRENT_CONTRACT_ID=CANJ564LVB4WBAYJWXRQKHJII456RW6XBWWM2FQCSSC6HLG27JP2A5O2

# NUNCA pongas aquí claves secretas (las que empiezan con S) ni frases de
# recuperación. Las identidades se guardan con `stellar keys` en tu equipo,
# fuera del repositorio.
